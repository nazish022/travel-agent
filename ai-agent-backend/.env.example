# Copy to .env and fill in your keys:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# Gemini (the chat model) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpApi (flights + hotels, 250 free searches/month) - https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# AviationStack (live flight status, ~100 free requests/month, HTTP only) - https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=

# Gemini model to use. Don't leave it empty: an empty value replaces the default with a blank name.
CHAT_MODEL=
